{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/akshaynexus/macos_helios300/tools/release/manifest.schema.json",
  "title": "macos_helios300 release manifest",
  "description": "dist/manifest.json of a macos_helios300 release (docs/MANIFEST.md). Consumers (1401) pin the manifest's own SHA-256 and check every artifact against the sha256 listed here.",
  "type": "object",
  "required": ["schema", "repo", "release", "machine", "macos", "artifacts", "external_kexts", "config", "post_install"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": 1},
    "about": {"type": "string"},
    "repo": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "release": {
      "type": "object",
      "required": ["version", "tag", "commit", "dirty", "pre_release", "built", "built_on", "sources"],
      "additionalProperties": false,
      "properties": {
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.]+)?$"},
        "tag": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.]+)?$"},
        "commit": {"$ref": "#/$defs/commit"},
        "dirty": {"type": "boolean"},
        "pre_release": {"type": "boolean"},
        "dry_run": {"type": "boolean"},
        "built": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:]{8}Z$"},
        "built_on": {"type": "string"},
        "sources": {
          "type": "object",
          "required": ["self", "driver"],
          "additionalProperties": {"type": "object", "required": ["repo", "commit"], "additionalProperties": false,
                                   "properties": {"repo": {"type": "string"}, "commit": {"$ref": "#/$defs/commit"}, "ref": {"type": "string"}}}
        },
        "missing": {"type": "array", "items": {"type": "object", "required": ["name", "why"], "additionalProperties": false,
                                                 "properties": {"name": {"type": "string"}, "why": {"type": "string"}}}},
        "kc_audit": {
          "type": "object",
          "required": ["status"],
          "additionalProperties": false,
          "properties": {
            "status": {"enum": ["pass", "fail", "skipped"]},
            "kc_dir": {"type": "string"},
            "collections": {"type": "array", "items": {"type": "object", "required": ["file", "sha256"], "additionalProperties": false,
                                                         "properties": {"file": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}}}},
            "results": {"type": "array", "items": {"type": "object", "required": ["name", "collections", "result"], "additionalProperties": false,
                                                     "properties": {"name": {"type": "string"},
                                                                    "collections": {"type": "array", "items": {"enum": ["Boot", "System"]}},
                                                                    "result": {"enum": ["pass", "fail", "not-built"]},
                                                                    "summary": {"type": "string"}}}},
            "log": {"type": "string"},
            "why": {"type": "string"}
          }
        }
      }
    },
    "machine": {
      "type": "object",
      "required": ["name", "match"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "match": {
          "type": "object",
          "required": ["dmi_product", "pci"],
          "additionalProperties": false,
          "properties": {
            "dmi_product": {"type": "array", "items": {"type": "string"}, "minItems": 1},
            "dmi_board": {"type": "array", "items": {"type": "string"}},
            "pci": {"type": "array", "items": {"$ref": "#/$defs/device_match"}, "minItems": 1},
            "usb": {"type": "array", "items": {"$ref": "#/$defs/device_match"}},
            "hda_codecs": {"type": "array", "items": {"$ref": "#/$defs/device_match"}}
          }
        }
      }
    },
    "macos": {
      "type": "object",
      "required": ["min_kernel", "max_kernel"],
      "additionalProperties": false,
      "properties": {
        "min_kernel": {"$ref": "#/$defs/kernel"},
        "max_kernel": {"$ref": "#/$defs/kernel"},
        "names": {"type": "array", "items": {"type": "string"}}
      }
    },
    "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
    "external_kexts": {
      "type": "array",
      "items": {"type": "object", "required": ["name", "source", "min_version"], "additionalProperties": false,
                "properties": {"name": {"$ref": "#/$defs/bundle_name"}, "source": {"type": "string"},
                               "min_version": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+){0,3}$"}, "why": {"type": "string"}}}
    },
    "config": {
      "type": "object",
      "required": ["boot_args", "nvram_add", "nvram_delete", "device_properties", "forbidden"],
      "additionalProperties": false,
      "properties": {
        "boot_args": {"type": "array", "items": {"$ref": "#/$defs/boot_arg"}},
        "nvram_add": {"type": "object", "propertyNames": {"$ref": "#/$defs/guid"},
                      "additionalProperties": {"type": "object", "additionalProperties": {"$ref": "#/$defs/plist_value"}}},
        "nvram_delete": {"type": "object", "propertyNames": {"$ref": "#/$defs/guid"},
                         "additionalProperties": {"type": "array", "items": {"type": "string"}}},
        "device_properties": {"type": "object", "propertyNames": {"$ref": "#/$defs/pci_path"},
                              "additionalProperties": {"type": "object", "additionalProperties": {"$ref": "#/$defs/plist_value"}}},
        "usb_ports": {"type": "array", "items": {"type": "object", "required": ["controller", "port", "type"], "additionalProperties": false,
                      "properties": {"controller": {"type": "string", "pattern": "^[0-9a-f]{4}:[0-9a-f]{4}$"}, "port": {"type": "string", "pattern": "^(HS|SS|USR)[0-9]{2}$"},
                                     "type": {"type": "integer", "minimum": 0, "maximum": 255}, "what": {"type": "string"}}}},
        "forbidden": {
          "type": "object",
          "required": ["kexts", "boot_args"],
          "additionalProperties": false,
          "properties": {
            "kexts": {"type": "array", "items": {"$ref": "#/$defs/bundle_name"}},
            "boot_args": {"type": "array", "items": {"$ref": "#/$defs/boot_arg"}},
            "device_properties": {"type": "object", "propertyNames": {"$ref": "#/$defs/pci_path"}, "additionalProperties": {"type": "array", "items": {"type": "string"}}},
            "acpi": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+\\.aml$"}}
          }
        }
      }
    },
    "post_install": {
      "type": "array",
      "items": {"type": "object", "required": ["step", "what", "artifacts"], "additionalProperties": false,
                "properties": {"step": {"type": "string", "pattern": "^[a-z0-9-]+$"}, "what": {"type": "string"},
                               "artifacts": {"type": "array", "items": {"type": "string"}},
                               "order": {"type": "integer", "minimum": 0},
                               "group": {"type": "string", "pattern": "^[a-z0-9-]+$"},
                               "choice": {"type": "integer", "minimum": 1},
                               "script": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+\\.sh$"},
                               "run": {"type": "object", "additionalProperties": false, "minProperties": 1,
                                       "properties": {"check": {"type": "string"}, "install": {"type": "string"},
                                                      "revert": {"type": "string"}, "status": {"type": "string"}}},
                               "cwd": {"type": "string"},
                               "reboot": {"type": "boolean"},
                               "needs": {"type": "array", "items": {"type": "string"}},
                               "rerun_after_macos_update": {"type": "boolean"},
                               "notes": {"type": "array", "items": {"type": "string"}}}}
    }
  },
  "$defs": {
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "kernel": {"type": "string", "pattern": "^([0-9]+\\.[0-9]+\\.[0-9]+)?$"},
    "guid": {"type": "string", "pattern": "^[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}$"},
    "pci_path": {"type": "string", "pattern": "^PciRoot\\(0x[0-9A-Fa-f]+\\)(/Pci\\(0x[0-9A-Fa-f]+,0x[0-9A-Fa-f]+\\))+$"},
    "boot_arg": {"type": "string", "pattern": "^-?[A-Za-z0-9_]+(=[^\\s]*)?$"},
    "bundle_name": {"type": "string", "pattern": "^[A-Za-z0-9_+ .-]+\\.(kext|bundle|app|dylib)$"},
    "hex4": {"type": "string", "pattern": "^[0-9a-f]{4}$"},
    "device_match": {
      "type": "object",
      "required": ["vendor", "device"],
      "additionalProperties": false,
      "properties": {
        "bus": {"enum": ["pci", "usb", "hda"]},
        "vendor": {"$ref": "#/$defs/hex4"}, "device": {"$ref": "#/$defs/hex4"},
        "subsystem_vendor": {"$ref": "#/$defs/hex4"}, "subsystem_device": {"$ref": "#/$defs/hex4"},
        "what": {"type": "string"}, "required": {"type": "boolean"}
      }
    },
    "plist_value": {
      "type": "object",
      "minProperties": 1, "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "data": {"type": "string", "pattern": "^([0-9a-f]{2})*$"},
        "string": {"type": "string"},
        "integer": {"type": "integer"},
        "boolean": {"type": "boolean"}
      }
    },
    "opencore_kext": {
      "type": "object",
      "required": ["order", "BundlePath", "ExecutablePath", "PlistPath", "Arch", "MinKernel", "MaxKernel", "Enabled", "Comment"],
      "additionalProperties": false,
      "properties": {
        "order": {"type": "integer", "minimum": 0},
        "BundlePath": {"$ref": "#/$defs/bundle_name"},
        "ExecutablePath": {"type": "string"},
        "PlistPath": {"const": "Contents/Info.plist"},
        "Arch": {"enum": ["x86_64", "Any"]},
        "MinKernel": {"$ref": "#/$defs/kernel"},
        "MaxKernel": {"$ref": "#/$defs/kernel"},
        "Enabled": {"type": "boolean"},
        "Comment": {"type": "string", "pattern": "^[ -}]*$"}
      }
    },
    "opencore_acpi": {
      "type": "object",
      "required": ["order", "Path", "Enabled", "Comment"],
      "additionalProperties": false,
      "properties": {
        "order": {"type": "integer", "minimum": 0},
        "Path": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+\\.aml$"},
        "Enabled": {"type": "boolean"},
        "Comment": {"type": "string", "pattern": "^[ -}]*$"}
      }
    },
    "artifact": {
      "type": "object",
      "required": ["name", "kind", "version", "file", "sha256", "size", "url", "licence", "status", "install", "requires", "source", "built_by"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "kind": {"enum": ["kext", "ssdt", "dylib", "bundle", "app", "firmware-licence", "script"]},
        "version": {"type": "string"},
        "bundle_id": {"type": "string"},
        "file": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 1},
        "url": {"type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+/releases/download/[^/]+/[^/]+$"},
        "contents_sha256": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha256"}},
        "licence": {"type": "string"},
        "licence_files": {"type": "array", "items": {"type": "string"}},
        "contains_firmware": {"type": "string"},
        "status": {"type": "string"},
        "install": {"enum": ["opencore", "library-extensions", "gpu-bundles", "applications", "stick-only"]},
        "install_path": {"type": "string"},
        "opencore": {"$ref": "#/$defs/opencore_kext"},
        "acpi": {"$ref": "#/$defs/opencore_acpi"},
        "requires": {"type": "array", "items": {"type": "string"}},
        "conflicts": {"type": "array", "items": {"$ref": "#/$defs/bundle_name"}},
        "optional": {"type": "boolean"},
        "personality": {"type": "object", "additionalProperties": {"$ref": "#/$defs/plist_value"}},
        "third_party": {"type": "array", "items": {"type": "object", "required": ["path", "what", "licence", "notices"], "additionalProperties": false,
                                                   "properties": {"path": {"type": "string"}, "what": {"type": "string"}, "licence": {"type": "string"},
                                                                  "notices": {"type": "array", "items": {"type": "string"}, "minItems": 1},
                                                                  "source_url": {"type": "string"}, "source_sha256": {"$ref": "#/$defs/sha256"}}}},
        "hardware": {"type": "array", "items": {"$ref": "#/$defs/device_match"}},
        "boot_args_optional": {"type": "array", "items": {"type": "object", "required": ["arg", "what"], "additionalProperties": false,
                                                          "properties": {"arg": {"$ref": "#/$defs/boot_arg"}, "what": {"type": "string"}}}},
        "source": {"type": "object", "required": ["tree", "path"], "additionalProperties": false,
                   "properties": {"tree": {"enum": ["self", "driver"]}, "path": {"type": "string"}}},
        "built_by": {"enum": ["cross", "iasl", "copy"]},
        "signed": {"enum": ["ad-hoc (rcodesign)", "unsigned"]}
      },
      "allOf": [
        {"if": {"properties": {"install": {"const": "opencore"}, "kind": {"const": "kext"}}}, "then": {"required": ["opencore", "bundle_id"]}},
        {"if": {"properties": {"kind": {"const": "ssdt"}}}, "then": {"required": ["acpi"]}}
      ]
    }
  }
}
