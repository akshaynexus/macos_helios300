# kpi-audit allowlist for AirportAth10k: every imported family symbol must be
# declared in one of these headers (tools/kpi-audit.py "hdr" rule). The Apple
# IO80211/Skywalk/corecapture declarations are the reconstructed headers under
# native/include/Airport (paths absolute at build time, see cross-build-native.sh).
hdr com.apple.iokit.IONetworkingFamily IOKit/network/IOEthernetController.h
hdr com.apple.iokit.IONetworkingFamily IOKit/network/IONetworkController.h
hdr com.apple.iokit.IONetworkingFamily IOKit/network/IOEthernetInterface.h
hdr com.apple.iokit.IONetworkingFamily IOKit/network/IONetworkInterface.h
hdr com.apple.iokit.IONetworkingFamily IOKit/network/IONetworkMedium.h
hdr com.apple.iokit.IONetworkingFamily IOKit/network/IOOutputQueue.h
hdr com.apple.iokit.IONetworkingFamily IOKit/network/IOGatedOutputQueue.h
hdr com.apple.iokit.IONetworkingFamily IOKit/network/IOBasicOutputQueue.h
hdr com.apple.iokit.IONetworkingFamily IOKit/network/IONetworkData.h
hdr com.apple.iokit.IONetworkingFamily IOKit/network/IONetworkStats.h
sym com.apple.iokit.IONetworkingFamily _gIONetworkFilterGroup
# Private SPI (exported by IONetworkingFamily 3.4): ifnet sub-family Wi-Fi for the BSD interface.
sym com.apple.iokit.IONetworkingFamily __ZN18IONetworkInterface19setInterfaceSubTypeEj
# Output pull model SPI (IONetworkingFamily 3.4): configureOutputPullModel, dequeueOutputPackets.
sym com.apple.iokit.IONetworkingFamily __ZN18IONetworkInterface24configureOutputPullModelEjjjjj
sym com.apple.iokit.IONetworkingFamily __ZN18IONetworkInterface20dequeueOutputPacketsEjPP6__mbufS2_PjPy
# Output thread control (the thread is halted from IONetworkInterface::init until startOutputThread; run 7).
sym com.apple.iokit.IONetworkingFamily __ZN18IONetworkInterface17startOutputThreadEj
sym com.apple.iokit.IONetworkingFamily __ZN18IONetworkInterface16stopOutputThreadEj
sym com.apple.iokit.IONetworkingFamily __ZN18IONetworkInterface16flushOutputQueueEj
hdr com.apple.iokit.IO80211Family @AIRPORT@/macOS26/IO80211ControllerV2.h
hdr com.apple.iokit.IO80211Family @AIRPORT@/macOS26/IO80211SkywalkInterface.h
hdr com.apple.iokit.IO80211Family @AIRPORT@/macOS26/IO80211InfraInterface.h
hdr com.apple.iokit.IO80211Family @AIRPORT@/macOS26/IO80211InfraProtocol.h
hdr com.apple.iokit.IO80211Family @AIRPORT@/macOS26/IO80211AWDLProtocol.h
# AWDL: the controller is told which interface is the AWDL one (AIRPORT_ATH10K_AWDL builds).
sym com.apple.iokit.IO80211Family __ZN17IO80211Controller16setAwdlInterfaceEP23IO80211VirtualInterface
# AWDL: the path AppleBCMWLANProximityInterface uses to hand a received action frame to the family's peer manager.
sym com.apple.iokit.IO80211Family __ZN23IO80211VirtualInterface11bpfTapInputEP6__mbufjPvm
# AWDL: the kernel's neighbor-entry API for AWDL peers (Private.exports; docs/WIFI-AWDL.md section 5c).
sym com.apple.kpi.bsd _nd6_alt_node_present
sym com.apple.kpi.bsd _nd6_alt_node_absent
hdr com.apple.iokit.IO80211Family @AIRPORT@/macOS26/IO80211WorkQueue.h
hdr com.apple.iokit.IO80211Family @AIRPORT@/macOS26/FaultReporter.h
hdr com.apple.iokit.IOSkywalkFamily @AIRPORT@/macOS26/IOSkywalkInterface.h
hdr com.apple.iokit.IOSkywalkFamily @AIRPORT@/macOS26/IOSkywalkNetworkInterface.h
hdr com.apple.iokit.IOSkywalkFamily @AIRPORT@/macOS26/IOSkywalkEthernetInterface.h
hdr com.apple.driver.corecapture @AIRPORT@/CCPipe.h
hdr com.apple.driver.corecapture @AIRPORT@/CCStream.h
hdr com.apple.driver.corecapture @AIRPORT@/CCLogStream.h
hdr com.apple.driver.corecapture @AIRPORT@/macOS26/FaultReporter.h
# The ath10k core kext (same tree): the front end links its control ABI and native hooks.
hdr br.com.jonasw8.driver.ath10kmac @CORE@/Ath10kPCIDevice.hpp
